<Window x:Class="PRKingNotepad.SaveChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRKing Notepad" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12" MinWidth="320" MaxWidth="480">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="_Salvar" IsDefault="True" MinWidth="80" Padding="8,3" Margin="0,0,6,0" Click="OnSave" />
            <Button x:Name="DontSaveButton" Content="_Não salvar" MinWidth="80" Padding="8,3" Margin="0,0,6,0" Click="OnDontSave" />
            <Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" MinWidth="80" Padding="8,3" />
        </StackPanel>
    </StackPanel>
</Window>
