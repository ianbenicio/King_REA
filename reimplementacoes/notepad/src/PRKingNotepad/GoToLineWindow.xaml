<Window x:Class="PRKingNotepad.GoToLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ir para linha" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10" MinWidth="240">
        <Label Content="_Número da linha:" Target="{Binding ElementName=LineBox}" Padding="0,0,0,4" />
        <TextBox x:Name="LineBox" PreviewTextInput="OnPreviewTextInput" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="_Ir" IsDefault="True" MinWidth="80" Padding="8,3" Margin="0,0,6,0" Click="OnGo" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="80" Padding="8,3" />
        </StackPanel>
    </StackPanel>
</Window>
