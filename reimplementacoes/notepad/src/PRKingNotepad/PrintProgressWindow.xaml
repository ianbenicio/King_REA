<Window x:Class="PRKingNotepad.PrintProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imprimindo" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14" MinWidth="300">
        <TextBlock x:Name="DocumentText" TextTrimming="CharacterEllipsis" MaxWidth="360" />
        <TextBlock x:Name="PageText" Margin="0,6,0,0" />
        <ProgressBar x:Name="Bar" Height="14" Margin="0,8,0,0" />
        <Button Content="Cancelar" IsCancel="True" HorizontalAlignment="Center" MinWidth="80" Padding="8,3"
                Margin="0,12,0,0" Click="OnCancel" />
    </StackPanel>
</Window>
