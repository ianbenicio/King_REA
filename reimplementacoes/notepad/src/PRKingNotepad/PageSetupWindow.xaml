<Window x:Class="PRKingNotepad.PageSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar página" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10" MinWidth="420">
        <GroupBox Header="Papel">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="_Tamanho:" Target="{Binding ElementName=SizeBox}" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SizeBox" Margin="0,2" />
                <Label Grid.Row="1" Content="_Origem:" Target="{Binding ElementName=SourceBox}" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SourceBox" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="PrinterText" Margin="4,6,0,0" Foreground="Gray"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </GroupBox>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Orientação">
                <StackPanel Margin="6">
                    <RadioButton x:Name="PortraitRadio" Content="_Retrato" Margin="0,2" />
                    <RadioButton x:Name="LandscapeRadio" Content="_Paisagem" Margin="0,2" />
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Margens (mm)">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Esquerda:" Target="{Binding ElementName=LeftBox}" />
                    <TextBox Grid.Column="1" x:Name="LeftBox" Margin="0,2" />
                    <Label Grid.Column="2" Content="_Direita:" Target="{Binding ElementName=RightBox}" />
                    <TextBox Grid.Column="3" x:Name="RightBox" Margin="0,2" />
                    <Label Grid.Row="1" Content="_Superior:" Target="{Binding ElementName=TopBox}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TopBox" Margin="0,2" />
                    <Label Grid.Row="1" Grid.Column="2" Content="_Inferior:" Target="{Binding ElementName=BottomBox}" />
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="BottomBox" Margin="0,2" />
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="_Cabeçalho:" Target="{Binding ElementName=HeaderBox}" />
            <TextBox Grid.Column="1" x:Name="HeaderBox" Margin="0,2" />
            <Label Grid.Row="1" Content="Rodap_é:" Target="{Binding ElementName=FooterBox}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FooterBox" Margin="0,2" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="4,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="Códigos: &amp;f arquivo, &amp;p página, &amp;d data, &amp;t hora, &amp;l / &amp;c / &amp;r alinham à esquerda, ao centro ou à direita, &amp;&amp; um &amp;." />
        </Grid>

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="I_mpressora..." MinWidth="90" Padding="8,3" Click="OnChoosePrinter" />
            <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" MinWidth="80" Padding="8,3" />
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" MinWidth="80" Padding="8,3" Margin="0,0,6,0"
                    Click="OnOk" />
        </DockPanel>
    </StackPanel>
</Window>
