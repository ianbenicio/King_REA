<Window x:Class="PRKingNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PRKingNotepad"
        Title="PRKing Notepad" Width="900" Height="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Loaded="OnLoaded" Closing="OnClosing"
        PreviewDragEnter="OnPreviewDragOver" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnPreviewDrop">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="OnNew" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpen" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSave" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="OnSaveAs" />
        <CommandBinding Command="local:AppCommands.NewWindow" Executed="OnNewWindow" />
        <CommandBinding Command="local:AppCommands.InsertDateTime" Executed="OnInsertDateTime" />
        <CommandBinding Command="local:AppCommands.DeleteSelection" Executed="OnDeleteSelection"
                        CanExecute="CanDeleteSelection" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
        <CommandBinding Command="ApplicationCommands.Replace" Executed="OnReplace" />
        <CommandBinding Command="local:AppCommands.FindNext" Executed="OnFindNext" />
        <CommandBinding Command="local:AppCommands.FindPrevious" Executed="OnFindPrevious" />
        <CommandBinding Command="local:AppCommands.GoToLine" Executed="OnGoToLine" />
        <CommandBinding Command="local:AppCommands.ZoomIn" Executed="OnZoomIn" />
        <CommandBinding Command="ApplicationCommands.Print" Executed="OnPrint" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="OnHelp" />
        <CommandBinding Command="local:AppCommands.ZoomOut" Executed="OnZoomOut" />
        <CommandBinding Command="local:AppCommands.ZoomReset" Executed="OnZoomReset" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.SaveAs" Gesture="Ctrl+Shift+S" />
        <KeyBinding Command="local:AppCommands.NewWindow" Gesture="Ctrl+Shift+N" />
        <KeyBinding Command="local:AppCommands.InsertDateTime" Gesture="F5" />
        <KeyBinding Command="local:AppCommands.FindNext" Gesture="F3" />
        <KeyBinding Command="local:AppCommands.FindPrevious" Gesture="Shift+F3" />
        <KeyBinding Command="local:AppCommands.GoToLine" Gesture="Ctrl+G" />
        <KeyBinding Command="local:AppCommands.ZoomIn" Gesture="Ctrl+OemPlus" />
        <KeyBinding Command="local:AppCommands.ZoomIn" Gesture="Ctrl+Add" />
        <KeyBinding Command="local:AppCommands.ZoomOut" Gesture="Ctrl+OemMinus" />
        <KeyBinding Command="local:AppCommands.ZoomOut" Gesture="Ctrl+Subtract" />
        <KeyBinding Command="local:AppCommands.ZoomReset" Gesture="Ctrl+D0" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo" Command="ApplicationCommands.New" />
                <MenuItem Header="Nova _janela" Command="local:AppCommands.NewWindow" InputGestureText="Ctrl+Shift+N" />
                <MenuItem Header="_Abrir..." Command="ApplicationCommands.Open" />
                <MenuItem Header="_Salvar" Command="ApplicationCommands.Save" />
                <MenuItem Header="Salvar _como..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Configurar pá_gina..." Click="OnPageSetup" />
                <MenuItem Header="_Imprimir..." Command="ApplicationCommands.Print" />
                <Separator />
                <MenuItem Header="Sa_ir" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="_Desfazer" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}" />
                <Separator />
                <MenuItem Header="Recor_tar" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=Editor}" />
                <MenuItem Header="_Copiar" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}" />
                <MenuItem Header="Co_lar" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}" />
                <MenuItem Header="_Excluir" Command="local:AppCommands.DeleteSelection" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="_Localizar..." Command="ApplicationCommands.Find" />
                <MenuItem Header="Localizar _próxima" Command="local:AppCommands.FindNext" InputGestureText="F3" />
                <MenuItem Header="Localizar a_nterior" Command="local:AppCommands.FindPrevious" InputGestureText="Shift+F3" />
                <MenuItem Header="_Substituir..." Command="ApplicationCommands.Replace" />
                <MenuItem Header="_Ir para linha..." Command="local:AppCommands.GoToLine" InputGestureText="Ctrl+G" />
                <Separator />
                <MenuItem Header="Selecionar _tudo" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding ElementName=Editor}" />
                <MenuItem Header="_Hora e data" Command="local:AppCommands.InsertDateTime" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="_Formatar">
                <MenuItem x:Name="WordWrapMenuItem" Header="_Quebra automática de linha" IsCheckable="True"
                          Click="OnToggleWordWrap" />
                <MenuItem Header="_Fonte..." Click="OnChooseFont" />
            </MenuItem>
            <MenuItem Header="E_xibir">
                <MenuItem Header="_Zoom">
                    <MenuItem Header="_Ampliar" Command="local:AppCommands.ZoomIn" InputGestureText="Ctrl+=" />
                    <MenuItem Header="_Reduzir" Command="local:AppCommands.ZoomOut" InputGestureText="Ctrl+-" />
                    <MenuItem Header="Restaurar _zoom padrão" Command="local:AppCommands.ZoomReset" InputGestureText="Ctrl+0" />
                </MenuItem>
                <MenuItem x:Name="StatusBarMenuItem" Header="_Barra de status" IsCheckable="True" IsChecked="True"
                          Click="OnToggleStatusBar" />
            </MenuItem>
            <MenuItem Header="Aj_uda">
                <MenuItem Header="_Exibir ajuda" Command="ApplicationCommands.Help" />
                <Separator />
                <MenuItem Header="_Sobre o PRKing Notepad" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <StatusBar x:Name="StatusBar" DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0"><TextBlock x:Name="StatusMessage" TextTrimming="CharacterEllipsis" /></StatusBarItem>
            <Separator Grid.Column="1" />
            <StatusBarItem Grid.Column="2"><TextBlock x:Name="StatusPosition" /></StatusBarItem>
            <Separator Grid.Column="3" />
            <StatusBarItem Grid.Column="4"><TextBlock x:Name="StatusZoom" Text="100%" /></StatusBarItem>
            <Separator Grid.Column="5" />
            <StatusBarItem Grid.Column="6"><TextBlock x:Name="StatusLineEnding" /></StatusBarItem>
            <Separator Grid.Column="7" />
            <StatusBarItem Grid.Column="8"><TextBlock x:Name="StatusEncoding" /></StatusBarItem>
        </StatusBar>

        <TextBox x:Name="Editor"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 IsInactiveSelectionHighlightEnabled="True"
                 TextChanged="OnTextChanged" SelectionChanged="OnSelectionChanged"
                 PreviewMouseWheel="OnEditorMouseWheel" />
    </DockPanel>
</Window>
