{
  "mcpServers": {
    "rea": {
      "command": "node",
      "args": [
        "node_modules/rea-agents/scripts/rea.mjs",
        "mcp"
      ]
    },
    "ghidra": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/LaurieWired/GhidraMCP@1e980252087b2479a21b9ca6d82d5829538651a7",
        "--with",
        "mcp==1.30.0",
        "--with",
        "requests==2.34.2",
        "ghidra-mcp",
        "--ghidra-server",
        "http://127.0.0.1:8080/"
      ]
    }
  }
}
